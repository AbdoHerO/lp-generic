# tujjar.store — secrets for a non-Docker host (Hostinger, cPanel, XAMPP).
#
# Copy to config/.env and fill in. Gitignored, and config/ is denied by both
# .htaccess and the production vhost, so this file is not reachable over HTTP.
#
# On Docker you do NOT need this file: docker-compose.yml passes the same names
# as real environment variables, which take precedence over anything here.

# --- Database ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=

# --- Application ---------------------------------------------------------
APP_NAME=tujjar.store
# '' when the site is served at a domain root, '/lp_tifaw' under XAMPP.
APP_BASE_URL=
APP_ENV=production
APP_TIMEZONE=Africa/Casablanca

# --- Session -------------------------------------------------------------
SESSION_NAME=LPTIFAW_SESS
# true whenever the site is served over HTTPS.
COOKIE_SECURE=true
