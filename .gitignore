# ---------------------------------------------------------------
# Environment-specific config files (contain real credentials)
# ---------------------------------------------------------------
config/config.local.php
config/config.prod.php

# Secrets read by config/env.php on hosts without real environment variables.
config/.env
!config/.env.example

# The deployment environment file. Jenkins decodes it into the workspace from
# the encrypted CloudForge credential and removes it in the post block; it must
# never be committed, including when a build is interrupted mid-run.
.env
.env.production
.env.local
!.env.example

# ---------------------------------------------------------------
# OS / editor artefacts
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ---------------------------------------------------------------
# PHP / dependency manager
# ---------------------------------------------------------------
vendor/
composer.lock

# ---------------------------------------------------------------
# Uploaded files (large binary assets — serve from CDN/Sirv)
# ---------------------------------------------------------------
uploads/

# ---------------------------------------------------------------
# Logs & temp
# ---------------------------------------------------------------
*.log
*.cache
/tmp/
