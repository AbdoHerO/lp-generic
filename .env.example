# lp_tifaw — production environment.
#
# This file is documentation. The real one is stored encrypted in CloudForge as
# a "Deployment Environment File" credential and is never committed: the
# pipeline decodes it into .env at build time and deletes it in the post block.
#
# CloudForge refuses to deploy while any value still reads CHANGE_ME_*, so the
# placeholders below are a safety gate, not a suggestion.

# --- Application ---------------------------------------------------------
APP_NAME=tujjar.store
APP_ENV=production
APP_TIMEZONE=Africa/Casablanca
SESSION_NAME=LPTIFAW_SESS
# The site is served over HTTPS, so the session cookie must be Secure.
COOKIE_SECURE=true

# --- Database ------------------------------------------------------------
# Reached over the private compose network. No port is published to the VPS,
# so these credentials are not exposed even if the host firewall is wrong.
DB_NAME=lp_tifaw
DB_USER=lp_tifaw
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
# mysql:8.0 publishes arm64; mariadb:11 is a drop-in alternative.
DB_IMAGE=mysql:8.0

# --- Admin panel ---------------------------------------------------------
# sql/seed.sql ships admin/admin123. The container entrypoint applies the
# password below on every start, so the seeded default never reaches a public
# domain. Leave ADMIN_PASSWORD empty to keep whatever is already in the table.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# HOST_PORT is deliberately absent. CloudForge owns it as a Jenkins build
# parameter, because it must always equal the port the managed Nginx site
# proxies to — two places holding that number is how a domain starts answering
# 502 with nothing in the build log to explain it.
